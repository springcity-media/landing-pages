# Copy this file to .env.local for local development. These Firebase Web SDK
# values identify a Firebase app; they are not service-account credentials.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-development-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
