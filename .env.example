# Copy this file to .env.local for local development. These Firebase Web SDK
# values identify a Firebase app; they are not service-account credentials.
NEXT_PUBLIC_APP_ENV=local
# These demo identifiers are intentionally non-production values. They let a
# clean checkout use the local emulator without obtaining Firebase credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-landing-pages.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-landing-pages
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-landing-pages.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
