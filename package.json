{
  "name": "@springcity-media/landing-pages",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0",
    "npm": ">=11.4.2 <12"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "firebase emulators:start --only firestore --project demo-landing-pages",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-landing-pages 'node --test tests/firestore.rules.test.mjs'",
    "test": "vitest run",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm run type-check && npm test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "firebase": "12.9.0",
    "next": "16.2.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "24.13.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-next": "16.2.12",
    "firebase-admin": "13.6.1",
    "firebase-tools": "15.25.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
